# Copy these values into .env.local when testing against the local Supabase dev stack.
# After `npm run supabase:start`, run `npm run supabase:status`
# and replace the keys below with the values printed by the CLI.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_THEMETWEAKER=0

# Optional: comma-separated emails promoted by the legacy login flow.
ADMIN_EMAILS=
